rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts (Citizen & Department Officer)
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Municipal Departments
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Department Workers (Employee records, not users)
    match /workers/{workerId} {
      allow read: if true;
      allow write: if true;
    }

    // Civic Problem Reports (Legacy & Synced)
    match /reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Operational Real-World Water Issues (ONE issue for many citizen reports)
    match /waterIssues/{issueId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Individual Citizen Reports / Evidence submissions
    match /waterReports/{reportId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Progress updates log
    match /updates/{updateId} {
      allow read: if true;
      allow write: if true;
    }

    // Citizen post-resolution feedback
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    // Notification items
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
